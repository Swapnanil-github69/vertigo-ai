# Server Configuration
PORT=8000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Replace with your actual Neon PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vertigo?schema=public"

# Security & Tokens
JWT_ACCESS_SECRET="vertigo_access_token_secure_key_123456"
JWT_REFRESH_SECRET="vertigo_refresh_token_secure_key_123456"
CORS_ORIGIN="http://localhost:8000"

# AI Core Engine (Google Gemini)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Email Services (SMTP Settings)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user_placeholder"
SMTP_PASS="smtp_pass_placeholder"
SMTP_FROM="no-reply@vertigo.ai"
