datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum TransactionType {
  BUY
  SELL
}

enum ReportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ChatRole {
  USER
  SYSTEM
  ASSISTANT
}

model User {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  email             String             @unique
  passwordHash      String?
  name              String
  googleId          String?            @unique
  avatarUrl         String?
  emailVerified     Boolean            @default(false)
  role              Role               @default(USER)
  status            UserStatus         @default(ACTIVE)
  provider          String             @default("credentials")
  firstName         String?
  lastName          String?
  phoneNumber       String?
  dateOfBirth       DateTime?
  gender            String?
  country           String?
  language          String?            @default("en")
  locale            String?
  timezone          String?
  loginCount        Int                @default(0)
  lastLoginAt       DateTime?
  profileCompletion Int                @default(0)
  googleAvatarUrl   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  // Relations
  refreshTokens     RefreshToken[]
  preferences       UserPreferences?
  sessions          Session[]
  loginHistories    LoginHistory[]
  interactionLogs   InteractionLogs[]
  portfolios        Portfolio[]
  watchlists        Watchlist[]
  alerts            Alert[]
  reports           Report[]
  chats             AIChat[]
  notifications     Notification[]
  auditLogs         AuditLogs[]
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserPreferences {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @unique @db.ObjectId
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme              String   @default("dark")
  enableMfa          Boolean  @default(false)
  enableNotifications Boolean @default(true)
  enableAuditLogs    Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  device       String?
  active       Boolean  @default(true)
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model LoginHistory {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String   @db.ObjectId
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress              String?
  userAgent              String?
  os                     String?
  browser                String?
  device                 String?
  sessionId              String?
  provider               String   @default("credentials")
  otpGeneratedAt         DateTime?
  otpVerifiedAt          DateTime?
  loginTime              DateTime @default(now())
  logoutTime             DateTime?
  sessionDurationSeconds Int?
  status                 String   @default("SUCCESS") // SUCCESS, FAILED
  createdAt              DateTime @default(now())

  @@index([userId])
}

model InteractionLogs {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionModule String   // Viewed Stock, Viewed Portfolio, AI Prompt, Generated Report, etc.
  details      String   
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([actionModule])
}

model Portfolio {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String   @default("Primary Portfolio")
  totalValuation Float    @default(0.0)
  healthRating   Float    @default(100.0)
  beta           Float    @default(1.0)
  cashBalance    Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   Transaction[]

  @@index([userId])
}

model Transaction {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  portfolioId    String          @db.ObjectId
  portfolio      Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol         String
  type           TransactionType
  shares         Float
  pricePerShare  Float
  totalValue     Float
  timestamp      DateTime        @default(now())

  @@index([portfolioId])
  @@index([symbol])
}

model Watchlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
  @@index([userId])
}

model Alert {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol         String
  triggerType    String   // Price Above, Price Below, Volatility Spike
  thresholdValue Float
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([symbol])
}

model Report {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  userId       String       @db.ObjectId
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  reportType   String       // Full Comprehensive, Technical, Sentiment
  documentSize String?      // e.g. "1.2 MB"
  documentPath String?      // local path or S3 URL
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  @@index([userId])
  @@index([symbol])
}

model AIChat {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  userId       String           @db.ObjectId
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String           @default("New Analysis Session")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  conversations AIConversation[]

  @@index([userId])
}

model AIConversation {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  chatId     String   @db.ObjectId
  chat       AIChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role       ChatRole
  content    String   
  tokenCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([chatId])
}

model StockCache {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  symbol      String   @unique
  price       Float
  change      Float
  pctChange   Float
  volatility  String
  aiScore     Int
  name        String
  sector      String
  lastUpdated DateTime @default(now()) @updatedAt
}

model NewsCache {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  symbol      String
  title       String
  summary     String   
  url         String
  source      String
  sentiment   String   // Bullish, Bearish, Neutral
  publishedAt DateTime
  lastUpdated DateTime @default(now()) @updatedAt

  @@index([symbol])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Settings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       String   
  description String?
  lastUpdated DateTime @default(now()) @updatedAt
}

model AuditLogs {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String   
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([userId])
}

model Otp {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  code        String
  type        String    // e.g. REGISTRATION, LOGIN, PASSWORD_RESET, SENSITIVE_ACTION
  expiresAt   DateTime
  verifiedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([code])
}
